---
import { DEFAULT_ACCENT } from "../../client/app-constants.js";
import { sortedGroups } from "../../client/workspace-search.js";
import type { GroupSummary } from "../../types.js";

interface Props {
  groups: GroupSummary[];
}

const { groups } = Astro.props;
const recentGroups = sortedGroups(groups);
---

<ul class="directory-list">
  {
    recentGroups.length === 0 && (
      <li class="empty-row">
        No workspaces yet. Create one to start collecting Markdown documents.
      </li>
    )
  }
  {
    recentGroups.map((group) => (
      <li class="workspace-section">
        <header class="workspace-section-heading">
          <a
            class="workspace-section-title"
            href={`/workspaces/${encodeURIComponent(group.id)}`}
            style={`border-left-color: ${group.accentColor ?? DEFAULT_ACCENT}`}
          >
            <strong>{group.name}</strong>
            <span>{group.description ?? "No description yet."}</span>
          </a>
          <span class="workspace-section-count">
            {group.documents.length} document
            {group.documents.length === 1 ? "" : "s"}
          </span>
        </header>
        <ul class="document-card-list">
          {group.documents.length === 0 ? (
            <li class="document-card-empty">No documents yet.</li>
          ) : (
            group.documents.map((document) => (
              <li class="document-card-item">
                <a
                  class="document-card"
                  href={`/documents/${encodeURIComponent(document.id)}`}
                >
                  <strong>{document.title}</strong>
                  <span>
                    {document.role} · rev {document.revision}
                  </span>
                </a>
              </li>
            ))
          )}
        </ul>
      </li>
    ))
  }
</ul>
