---
import { DEFAULT_ACCENT } from "../../client/app-constants.js";
import type { GroupSummary } from "../../types.js";
import DocumentCard from "./DocumentCard.astro";

type Props = {
  group: GroupSummary;
};

const { group } = Astro.props;

function getAccentColor(group: GroupSummary) {
  return group.accentColor ?? DEFAULT_ACCENT;
}

const accentColor = getAccentColor(group);
---

<style define:vars={{ accentColor }}>
  .workspace-section {
    --directory-inline-gutter: clamp(28px, 6vw, 96px);
    display: grid;
    grid-template-rows: auto minmax(24px, 1fr);
    width: 100vw;
    min-height: 220px;
    margin-inline: calc((100% - 100vw) / 2);
    background: color-mix(in srgb, var(--surface) 64%, var(--accentColor));
    padding-top: 24px;
  }

  .workspace-section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: end;
    width: min(100% - (var(--directory-inline-gutter) * 2), 1060px);
    margin: 0 auto;
  }

  .workspace-section-title {
    display: grid;
    gap: 6px;
    width: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    padding: 4px 0 4px 18px;
    text-align: left;
  }

  .workspace-section-title:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .workspace-section-title span,
  .workspace-section-count {
    min-width: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .workspace-section-title strong {
    overflow: hidden;
    color: color-mix(in srgb, var(--accentColor) 18%, var(--text));
    font-size: 1.24rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .document-card-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    align-self: end;
    gap: 12px;
    width: 100%;
    margin-block: 0;
    padding: 0 var(--directory-inline-gutter);
    list-style: none;
  }

  .document-card-empty {
    min-height: 124px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 18%, var(--accentColor));
    color: var(--muted);
    font-size: 0.88rem;
    padding: 16px;
  }

  @media (max-width: 560px) {
    .workspace-section {
      --directory-inline-gutter: 16px;
    }

    .workspace-section-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
<li class="workspace-section">
  <header class="workspace-section-heading">
    <a
      class="workspace-section-title"
      href={`/workspaces/${encodeURIComponent(group.id)}`}
      style={`border-left-color: ${accentColor}`}
    >
      <strong>{group.name}</strong>
      <span>{group.description ?? "No description yet."}</span>
    </a>
    <span class="workspace-section-count">
      {group.documents.length} document
      {group.documents.length === 1 ? "" : "s"}
    </span>
  </header>
  <ul class="document-card-list">
    {
      group.documents.length === 0 ? (
        <li class="document-card-empty">No documents yet.</li>
      ) : (
        group.documents.map((document) => (
          <DocumentCard accentColor={accentColor} document={document} />
        ))
      )
    }
  </ul>
</li>
