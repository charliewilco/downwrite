---
import type { DocumentSummary } from "../../types.js";
import DocumentOrderControls from "./DocumentOrderControls.astro";

interface Props {
	accentColor: string;
	document: DocumentSummary;
	documents: DocumentSummary[];
	index: number;
}

const { accentColor, document, documents, index } = Astro.props;
---

<li class="document-card-item">
	<article class="document-card">
		<a
			class="document-card-link"
			href={`/documents/${encodeURIComponent(document.id)}`}
		>
			<strong>{document.title}</strong>
			<span>
				{document.role} · rev {document.revision}
			</span>
		</a>
		<DocumentOrderControls
			document={document}
			documents={documents}
			index={index}
		/>
	</article>
</li>

<style define:vars={{ accentColor }}>
	.document-card-item {
		min-width: 0;
	}

	.document-card {
		display: grid;
		grid-template-rows: 1fr auto;
		width: 100%;
		min-height: 148px;
		border: 1px solid var(--line);
		border-radius: 1rem 1rem 0 0;
		background: color-mix(in srgb, var(--surface) 18%, var(--accentColor));
		color: inherit;
		padding: 16px;
	}

	.document-card-link {
		display: grid;
		align-content: space-between;
		min-width: 0;
		color: inherit;
		text-align: left;
	}

	.document-card-link:hover strong {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.document-card-link strong {
		overflow: hidden;
		color: var(--text);
		font-size: 1rem;
		font-weight: 650;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.document-card-link span {
		color: var(--muted);
		font-size: 0.88rem;
	}

	.document-card :global(.order-actions) {
		justify-self: end;
		margin-top: 14px;
	}

	.document-card :global(.icon-action) {
		min-width: 36px;
		background: color-mix(in srgb, var(--surface) 36%, transparent);
		padding: 4px 7px;
	}
</style>
