---
import AppLayout from "../../layouts/AppLayout.astro";
import { DEFAULT_ACCENT } from "../../client/app-constants.js";
---

<AppLayout title="New Workspace - Downwrite">
  <section class="workspace-screen create-route">
    <header class="section-heading">
      <a class="back-button" href="/">Back</a>
      <div>
        <p class="eyebrow">New workspace</p>
        <h1>Start a writing space.</h1>
        <p>Keep a project, topic, or client separated from the rest.</p>
      </div>
    </header>
    <dw-create-workspace-form>
      <form class="settings-form">
        <label>
          <span>Name</span>
          <input name="name" />
        </label>
        <label>
          <span>Description</span>
          <textarea name="description"></textarea>
        </label>
        <label class="color-row">
          <span>Accent</span>
          <input name="accentColor" type="color" value={DEFAULT_ACCENT} />
        </label>
        <button class="primary-action" type="submit">Create workspace</button>
        <p class="inline-error" data-inline-error hidden></p>
      </form>
    </dw-create-workspace-form>
  </section>
</AppLayout>
