---
import AppLayout from "../../layouts/AppLayout.astro";
import { CreateWorkspaceForm } from "../../../web/src/islands/CreateWorkspaceForm.js";
---

<AppLayout title="New Workspace - Downwrite">
  <section class="workspace-screen create-route">
    <header class="section-heading">
      <a class="back-button" href="/">Back</a>
      <div>
        <p class="eyebrow">New workspace</p>
        <h1>Start a writing space.</h1>
        <p>Keep a project, topic, or client separated from the rest.</p>
      </div>
    </header>
    <CreateWorkspaceForm client:load />
  </section>
</AppLayout>
