---
import AppLayout from "../../../layouts/AppLayout.astro";
import { WorkspaceSettingsForm } from "../../../../web/src/islands/WorkspaceSettingsForm.js";
import { loadGroupForRequest } from "../../../web/page-data.js";

const groupId = Astro.params.groupId ?? "";
const { group, error } = await loadGroupForRequest(Astro.request, groupId);
---

<AppLayout
  title={group ? `${group.name} Settings - Downwrite` : "Workspace Settings - Downwrite"}
>
  {
    error ? (
      <p class="status error">{error}</p>
    ) : group ? (
      <section class="workspace-screen settings-route">
        <header class="section-heading">
          <a
            class="back-button"
            href={`/workspaces/${encodeURIComponent(group.id)}`}
          >
            Back to workspace
          </a>
          <div>
            <p class="eyebrow">Workspace settings</p>
            <h1>{group.name}</h1>
            <p>Manage the project details separately from document writing.</p>
          </div>
        </header>
        <WorkspaceSettingsForm client:load group={group} />
      </section>
    ) : (
      <section class="workspace-screen empty-document">
        <a class="back-button" href="/">Back</a>
        <h1>Workspace not found</h1>
        <p>This workspace may have been deleted or hidden from this identity.</p>
      </section>
    )
  }
</AppLayout>
