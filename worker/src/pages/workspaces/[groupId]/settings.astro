---
import AppLayout from "../../../layouts/AppLayout.astro";
import { loadGroupForRequest } from "../../../web/page-data.js";
import { DEFAULT_ACCENT } from "../../../client/app-constants.js";

const groupId = Astro.params.groupId ?? "";
const { group, error } = await loadGroupForRequest(Astro.request, groupId);
---

<AppLayout
  title={group ? `${group.name} Settings - Downwrite` : "Workspace Settings - Downwrite"}
>
  {
    error ? (
      <p class="status error">{error}</p>
    ) : group ? (
      <section class="workspace-screen settings-route">
        <header class="section-heading">
          <a
            class="back-button"
            href={`/workspaces/${encodeURIComponent(group.id)}`}
          >
            Back to workspace
          </a>
          <div>
            <p class="eyebrow">Workspace settings</p>
            <h1>{group.name}</h1>
            <p>Manage the project details separately from document writing.</p>
          </div>
        </header>
        <dw-workspace-settings-form group-id={group.id}>
          <form class="settings-form">
            <label>
              <span>Name</span>
              <input name="name" value={group.name} />
            </label>
            <label>
              <span>Description</span>
              <textarea name="description">{group.description ?? ""}</textarea>
            </label>
            <label class="color-row">
              <span>Accent</span>
              <input
                name="accentColor"
                type="color"
                value={group.accentColor ?? DEFAULT_ACCENT}
              />
            </label>
            <button class="primary-action" type="submit">
              Save workspace
            </button>
          </form>
          <section class="danger-zone">
            <div>
              <h2>Delete workspace</h2>
              <p>
                This removes the workspace and its documents from this
                self-hosted instance.
              </p>
            </div>
            <div class="toolbar-actions">
              <button
                class="secondary-action"
                type="button"
                data-cancel-delete
                hidden
              >
                Cancel
              </button>
              <button class="danger-action" type="button" data-delete-workspace>
                Delete workspace
              </button>
            </div>
          </section>
          <p class="inline-notice" data-inline-notice hidden></p>
          <p class="inline-error" data-inline-error hidden></p>
        </dw-workspace-settings-form>
      </section>
    ) : (
      <section class="workspace-screen empty-document">
        <a class="back-button" href="/">Back</a>
        <h1>Workspace not found</h1>
        <p>This workspace may have been deleted or hidden from this identity.</p>
      </section>
    )
  }
</AppLayout>
