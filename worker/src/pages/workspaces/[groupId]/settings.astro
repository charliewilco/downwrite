---
import AppLayout from "../../../layouts/AppLayout.astro";
import EmptyState from "../../../components/EmptyState.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import WorkspaceSettingsForm from "../../../components/forms/WorkspaceSettingsForm.astro";
import { loadGroupForRequest } from "../../../web/page-data.js";

const groupId = Astro.params.groupId ?? "";
const { group, error } = await loadGroupForRequest(Astro.request, groupId);
---

<AppLayout
  title={group ? `${group.name} Settings - Downwrite` : "Workspace Settings - Downwrite"}
>
  {
    error ? (
      <p class="status error">{error}</p>
    ) : group ? (
      <section class="workspace-screen settings-route">
        <SectionHeading
          backHref={`/workspaces/${encodeURIComponent(group.id)}`}
          backLabel="Back to workspace"
          description="Manage the project details separately from document writing."
          eyebrow="Workspace settings"
          title={group.name}
        />
        <WorkspaceSettingsForm group={group} />
      </section>
    ) : (
      <EmptyState
        backHref="/"
        class="workspace-screen empty-document"
        description="This workspace may have been deleted or hidden from this identity."
        title="Workspace not found"
      />
    )
  }
</AppLayout>
