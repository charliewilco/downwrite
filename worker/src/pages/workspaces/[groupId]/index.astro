---
import AppLayout from "../../../layouts/AppLayout.astro";
import EmptyState from "../../../components/EmptyState.astro";
import WorkspaceDetail from "../../../components/workspaces/WorkspaceDetail.astro";
import { loadGroupForRequest } from "../../../web/page-data.js";

const groupId = Astro.params.groupId ?? "";
const { group, error } = await loadGroupForRequest(Astro.request, groupId);
---

<AppLayout title={group ? `${group.name} - Downwrite` : "Workspace - Downwrite"}>
  {
    error ? (
      <p class="status error">{error}</p>
    ) : group ? (
      <markdown-dragarea workspace-id={group.id}>
        <WorkspaceDetail group={group} />
      </markdown-dragarea>
    ) : (
      <section class="workspace-screen">
        <EmptyState
          class="workspace-detail empty-document"
          description="Create a workspace to start organizing Markdown documents."
          title="No workspaces"
        />
      </section>
    )
  }
</AppLayout>
