---
import AppLayout from "../../../layouts/AppLayout.astro";
import EmptyState from "../../../components/EmptyState.astro";
import CreateDocumentButton from "../../../components/workspaces/CreateDocumentButton.astro";
import WorkspaceDocumentList from "../../../components/workspaces/WorkspaceDocumentList.astro";
import { loadGroupForRequest } from "../../../web/page-data.js";
import { DEFAULT_ACCENT } from "../../../client/app-constants.js";

const groupId = Astro.params.groupId ?? "";
const { group, error } = await loadGroupForRequest(Astro.request, groupId);
---

<AppLayout title={group ? `${group.name} - Downwrite` : "Workspace - Downwrite"}>
  {
    error ? (
      <p class="status error">{error}</p>
    ) : group ? (
      <section class="workspace-screen">
        <markdown-dragarea workspace-id={group.id}>
          <section class="workspace-detail">
            <header
              class="workspace-heading"
              style={`border-top-color: ${group.accentColor ?? DEFAULT_ACCENT}`}
            >
              <div>
                <h1>{group.name}</h1>
                <p>{group.description ?? "No description yet."}</p>
              </div>
              <div class="toolbar-actions">
                <a
                  class="secondary-action"
                  href={`/workspaces/${encodeURIComponent(group.id)}/share`}
                >
                  Share
                </a>
                <a
                  class="secondary-action"
                  href={`/workspaces/${encodeURIComponent(group.id)}/settings`}
                >
                  Settings
                </a>
                <CreateDocumentButton groupId={group.id} />
              </div>
            </header>

            <WorkspaceDocumentList group={group} />
          </section>
        </markdown-dragarea>
      </section>
    ) : (
      <section class="workspace-screen">
        <EmptyState
          class="workspace-detail empty-document"
          description="Create a workspace to start organizing Markdown documents."
          title="No workspaces"
        />
      </section>
    )
  }
</AppLayout>
