---
import AppLayout from "../../layouts/AppLayout.astro";

const token = Astro.params.token ?? "";
---

<AppLayout title="Invitation - Downwrite">
  <section class="workspace-screen invitation-route">
    <header class="section-heading">
      <div>
        <p class="eyebrow">Invitation</p>
        <h1>Accept a document invitation.</h1>
        <p>
          Invitation tokens are instance-local. Sign in, then accept to gain the
          invited document role.
        </p>
      </div>
    </header>
    <dw-invitation-accept-form>
      <form class="settings-form">
        <label>
          <span>Invitation token</span>
          <input name="invitationToken" value={token} />
        </label>
        <button class="primary-action" type="submit">
          Accept invitation
        </button>
      </form>
      <p class="inline-notice" data-inline-notice hidden></p>
      <p class="inline-error" data-inline-error hidden></p>
    </dw-invitation-accept-form>
  </section>
</AppLayout>
