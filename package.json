{
  "name": "downwrite",
  "version": "0.1.0",
  "private": true,
  "repository": "charliewilco/downwrite",
  "author": "Charlie <charliewilc0@pm.me>",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev:worker": "npm --workspace @downwrite/worker run dev",
    "dev:web": "npm --workspace @downwrite/worker run dev:web",
    "dev:api": "npm --workspace @downwrite/worker run dev:api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm --workspace @downwrite/worker run test",
    "build": "npm run build --workspaces",
    "format:check": "npx --yes prettier@3.9.6 --check package.json tsconfig.json README.md documentation iOS worker",
    "validate": "npm run typecheck && npm run test && npm run build && npm --workspace @downwrite/worker run validate:worker"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
